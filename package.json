{
  "name": "perfscope",
  "version": "0.1.0",
  "description": "Per-route React component graph and automatic performance analysis for Next.js/React apps",
  "type": "module",
  "bin": { "perfscope": "dist/cli.js" },
  "files": ["dist", "README.md", "LICENSE"],
  "engines": { "node": ">=18.3" },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/rules/index.test.ts",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "keywords": ["performance", "react", "nextjs", "web-vitals", "playwright", "audit"],
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/<github-username>/perfscope.git" },
  "bugs": { "url": "https://github.com/<github-username>/perfscope/issues" },
  "homepage": "https://github.com/<github-username>/perfscope#readme",
  "dependencies": { "playwright": "^1.48.0" },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
